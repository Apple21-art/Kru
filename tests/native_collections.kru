fn sum(values: [i32; 4]) -> i32 {
    var total := 0
    for n in values { total += n }
    var local_values: [i32; 4] := [values[0], values[1], values[2], values[3]]
    local_values[0] = 100
    ret total
}
pub fn main() -> i32 {
    var values: [i32; 4] := [1, 2, 3, 4]
    values[1] += 9
    pr(sum(values))
    pr(values[0])
    for n in ref values { n@ = n@ * 2 }
    pr(values[1])
    pr(values.len)
    var total := 0
    for i in 0..8 {
        if i == 2 { continue }
        if i == 6 { break }
        total += i
    }
    pr(total)
    let answer := {
        let x := 3
        let x := x + 4
        x * 6
    }
    pr(answer)
    let flags: [bool; 3] := [true, false, true]
    var count := 0
    for flag in flags { if flag { count += 1 } }
    pr(count)
    ret 0
}
