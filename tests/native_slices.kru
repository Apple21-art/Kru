fn sum(values: ref [i16]) -> i32 {
    var i := 0
    var result := 0
    while i < values.len() {
        result += cast<i32>(values[i])
        i += 1
    }
    ret result
}
fn read(value: ref u64) -> u64 { ret value@ }
fn write(value: mut ref u64) { value@ = 18446744073709551615u64 }
pub fn main() -> i32 {
    let data: [i16; 5] := [10,20,30,40,50]
    let all: ref [i16] := ref data
    pr(all.len())
    pr(sum(all))
    let middle: ref [i16] := ref data[1..4]
    pr(middle.len())
    pr(sum(middle))
    pr(sum(data[..2]))
    pr(sum(data[3..]))
    pr(sum(data[..]))
    var value := 5u64
    write(mut ref value)
    pr(read(ref value))
    let wide := 170141183460469231731687303715884105727i128
    let wr: ref i128 := ref wide
    pr(wr@)
    ret 0
}
