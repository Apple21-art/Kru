pub fn main() -> i32 {
    if 1 | 2 == 3 { } else { ret 1 }
    if 2 & 1 == 0 { } else { ret 2 }
    if 3 ^ 1 == 2 { } else { ret 3 }
    if 1 | 2 < 4 { } else { ret 4 }
    if 2 & 1 < 1 { } else { ret 5 }
    if 8 >> 1 & 3 == 0 { } else { ret 6 }
    if 1 | 2 == 3 && 2 & 1 == 0 { } else { ret 7 }
    if 1 | 2 ^ 3 & 1 == 3 { } else { ret 8 }
    ret 0
}
