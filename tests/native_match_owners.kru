struct Owner { value:i32 }
impl Owner { fn drop(mut ref self) { pr(self.value) } }
enum Box { Item(Owner), Empty }
fn consume(value:Owner) {pr(value.value)}
fn run(which:bool) {
 let shared:=Owner {value:7}
 match which {true=>{consume(shared)} false=>{consume(shared)}}
 let a:=Box::Item(Owner {value:11})
 match a {Box::Item(value)=>{pr(value.value)} Box::Empty=>{}}
 let b:=Box::Item(Owner {value:12})
 match b {_=>{}}
}
pub fn main()->i32 {run(true);run(false);ret 0}
