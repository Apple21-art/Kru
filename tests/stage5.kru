// Stage 5: File I/O, CLI Args, Dynamic Allocation, Pointers, Modules
// Comprehensive test for all Stage 5 features.

// ---------------------------------------------------------------------------
// File I/O builtins: file_open, file_read, file_write, file_close,
// file_open_write
// ---------------------------------------------------------------------------

fn file_io_test() -> i32 {
    // Self-contained fixture: write it ourselves first instead of
    // depending on a pre-existing "test.txt" living outside this repo
    // snapshot (relying on an external fixture made this path silently
    // untested whenever the file wasn't present relative to the cwd
    // the compiler happened to run from).
    let fixture := file_open_write("stage5_fixture.txt")
    file_write(fixture, "Hello, Kru Stage 5!\nFile I/O works.\n")
    file_close(fixture)

    // Open it back up for reading, read its contents, print the length.
    let handle := file_open("stage5_fixture.txt")
    let content := file_read(handle)
    file_close(handle)

    // "Hello, Kru Stage 5!\nFile I/O works.\n" is 36 bytes.
    pr(str_len(content))

    // Round-trip the exact bytes, not just the length.
    if str_eq(content, "Hello, Kru Stage 5!\nFile I/O works.\n") {
        pr(1)
    }

    // Write a second file and verify we can read it back.
    let w := file_open_write("output_stage5.txt")
    file_write(w, "stage5 file write")
    file_close(w)

    let h2 := file_open("output_stage5.txt")
    let c2 := file_read(h2)
    file_close(h2)

    // "stage5 file write" is 18 bytes.
    pr(str_len(c2))

    // Overwrite an existing file and confirm the new contents replace
    // the old ones rather than appending.
    let w2 := file_open_write("output_stage5.txt")
    file_write(w2, "shorter")
    file_close(w2)

    let h3 := file_open("output_stage5.txt")
    let c3 := file_read(h3)
    file_close(h3)

    pr(str_len(c3))       // 7
    if str_eq(c3, "shorter") {
        pr(1)
    }

    ret 0
}


// ---------------------------------------------------------------------------
// CLI argument builtins: args_count, args_get
// ---------------------------------------------------------------------------

fn cli_args_test() -> i32 {
    // args_count returns argc. When run as ./out_bin, argc is 1.
    pr(args_count())

    // If there's at least one argument, print it.
    if args_count() > 1 {
        pr(args_get(1))
    }

    ret 0
}


// ---------------------------------------------------------------------------
// Dynamic allocation builtins: mem_alloc, mem_free, mem_realloc
// ---------------------------------------------------------------------------

fn alloc_test() -> i32 {
    // Allocate space for 4 i32 values (16 bytes).
    let ptr: *i32 := mem_alloc(16)

    // Check for null (allocation failure).
    if ptr == null {
        ret -1
    }

    // Write through the pointer using dereference (@).
    ptr@ = 100

    // Read back through the pointer.
    let val: i32 := ptr@
    pr(val)

    // Reallocate to hold 8 i32 values (32 bytes).
    let ptr2: *i32 := mem_realloc(ptr, 32)

    if ptr2 == null {
        ret -1
    }

    // Original value should still be there.
    let val2: i32 := ptr2@
    pr(val2)

    // Write at an offset (treating as array via pointer arithmetic).
    // Use a second allocation to test multi-value storage.
    let arr: *i32 := mem_alloc(12)

    if arr == null {
        ret -1
    }

    // Store values via dereference.
    arr@ = 10

    // Read back.
    pr(arr@)

    mem_free(ptr2)
    mem_free(arr)

    ret 0
}


// ---------------------------------------------------------------------------
// Pointer arithmetic: treating a heap allocation as a small array by
// walking a *i32 with `+` and dereferencing each computed address.
// ---------------------------------------------------------------------------

unsafe fn ptr_arith_test() -> i32 {
    let base: *i32 := mem_alloc(16)

    if base == null {
        ret -1
    }

    let p0: *i32 := base
    let p1: *i32 := base + 1
    let p2: *i32 := base + 2
    let p3: *i32 := base + 3

    p0@ = 10
    p1@ = 20
    p2@ = 30
    p3@ = 40

    let total := p0@ + p1@ + p2@ + p3@
    pr(total)

    mem_free(base)

    ret 0
}


// ---------------------------------------------------------------------------
// Pointer types and null literal
// ---------------------------------------------------------------------------

unsafe fn pointer_test() -> i32 {
    // Allocate a single i32 on the heap.
    let p: *i32 := mem_alloc(4)

    // Null check.
    if p == null {
        ret -1
    }

    // Write through pointer.
    p@ = 42

    // Read through pointer.
    let v := p@
    pr(v)

    // Null comparison: a freshly allocated pointer is not null.
    if p != null {
        pr(1)
    }

    mem_free(p)

    // After free, set to null (good practice).
    // We can't actually set p = null because p is immutable (let).
    // But we can test null literal directly.
    let np: *i32 := null

    if np == null {
        pr(0)
    }

    if np != null {
        // Should never fire; guards against a broken null comparison
        // silently treating every pointer as non-null.
        pr(-999)
    }

    ret 0
}


// ---------------------------------------------------------------------------
// Main entry point
// ---------------------------------------------------------------------------

pub fn main() -> i32 {
    file_io_test()
    cli_args_test()
    alloc_test()
    ptr_arith_test()
    pointer_test()

    ret 0
}
