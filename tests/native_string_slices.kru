use kru_string
use kru_io
struct Message {text:str,code:i32}
fn echo(text:str)->str {ret text}
pub fn main()->i32 {
 let text:=echo("a\0b")
 pr(text.len)
 pr(text[2])
 pr(text=="a\0c")
 pr(text=="a\0b")
 let message:=Message {text:text,code:42}
 pr(message.text.len)
 pr(message.code)
 let joined:=str_concat(text,"\0c")
 pr(joined.len)
 pr(joined[4])
 var owned:=kru_string::String::new()
 owned.push_str(joined)
 pr(owned.len())
 let view:=owned.as_str()
 pr(kru_io::str_len(ref view))
 pr(kru_io::str_eq(ref view,ref joined))
 let from:=kru_string::String::from("new\0text")
 pr(from.len())
 let combined:=kru_string::concat("first", " second")
 pr(combined.as_str())
 str_free(joined)
 ret 0
}
