// stage1.kru — Kru Stage 1 conformance test
// Tests: function params, full operator precedence, control flow,
//        primitive literals, compound assignment, K1xxx diagnostics


fn add(a: int, b: int) -> int {
    ret a + b
}


pub fn control_flow_test() -> int {
    // if / else
    var x: int := 10
    if x > 5 {
        pr(1)
    } else {
        pr(0)
    }

    // else if chain
    var y: int := 50
    if y < 10 {
        pr(10)
    } else if y < 100 {
        pr(100)
    } else {
        pr(1000)
    }

    // while loop
    var i: int := 0
    var sum: int := 0
    while i < 10 {
        sum = sum + i
        i = i + 1
    }
    pr(sum)

    // loop with break
    var j: int := 0
    loop {
        j = j + 1
        if j > 5 {
            break
        }
    }
    pr(j)

    // continue in a while loop
    var k: int := 0
    var evens: int := 0
    while k < 10 {
        k = k + 1
        if k == 5 {
            continue
        }
        evens = evens + 1
    }
    pr(evens)

    ret 0
}


pub fn operator_test() -> int {
    // Comparison operators
    let eq: int := 1 == 1
    let neq: int := 1 != 2
    let lt: int := 1 < 2
    let gt: int := 2 > 1
    let le: int := 1 <= 1
    let ge: int := 1 >= 1
    pr(eq)
    pr(neq)
    pr(lt)
    pr(gt)
    pr(le)
    pr(ge)

    // Logical operators
    let and_result: int := true && false
    let or_result: int := true || false
    let not_result: int := !false
    pr(and_result)
    pr(or_result)
    pr(not_result)

    // Bitwise operators
    let bitwise_or: int := 1 | 2
    let bitwise_and: int := 3 & 1
    let bitwise_xor: int := 1 ^ 1
    let shift_left: int := 1 << 4
    let shift_right: int := 256 >> 4
    pr(bitwise_or)
    pr(bitwise_and)
    pr(bitwise_xor)
    pr(shift_left)
    pr(shift_right)

    // Operator precedence: shift is lower than additive in C
    // 1 + 2 << 3 = (1 + 2) << 3 = 24
    let shift_after_add: int := 1 + 2 << 3
    pr(shift_after_add)

    // 1 << 2 + 1 = 1 << (2 + 1) = 8
    let shift_before_add: int := 1 << 2 + 1
    pr(shift_before_add)

    // Standard precedence
    let mixed: int := 2 + 3 * 4 - 10 / 2
    pr(mixed)

    let paren: int := (2 + 3) * 4
    pr(paren)

    ret 0
}


pub fn compound_assign_test() -> int {
    var n: int := 10
    n += 5
    pr(n)
    n -= 3
    pr(n)
    n *= 2
    pr(n)
    n /= 4
    pr(n)
    ret 0
}


pub fn params_test() -> int {
    let result: int := add(3, 4)
    pr(result)
    ret 0
}


pub fn main() -> int {
    control_flow_test()
    operator_test()
    compound_assign_test()
    params_test()

    // Char literal test
    let c := 'A'
    pr(c)
    let newline := '\n'
    pr(newline)

    pr(999)
    ret 0
}
