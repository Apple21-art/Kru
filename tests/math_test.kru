// ============================================================
//
//  math_test.kru
//
//  Tests:
//      - operator precedence
//      - nested parentheses
//      - integer division
//      - modulus
//      - unary minus
//      - chained arithmetic
//      - variable references
//      - assignment
//
// ============================================================

pub fn main()
-> int
{
    let a: int := 20
    let b: int := 6
    let c: int := 3
    let d: int := 8
    let e: int := 5

    // precedence
    let p1: int := a + b * c
    pr(p1)            // 38

    // parentheses
    let p2: int := (a - b) / c
    pr(p2)            // 4

    // nested expressions
    let p3: int := ((a + b) * (d - c)) / 2
    pr(p3)            // 65

    // modulus
    let p4: int := (a * d) % 7
    pr(p4)            // 6

    // unary minus
    let p5: int := -a + b
    pr(p5)            // -14

    // mixed arithmetic
    let p6: int := (a + b * c - d / 2 + e) * 2
    pr(p6)            // 58

    // variable references
    let p7: int := p1 + p2 + p3
    pr(p7)            // 107

    // chained assignment
    var total: int := 0
    total = p1
    total = total + p2
    total = total + p3
    total = total - p4
    total = total * 2
    pr(total)         // 202

    // deeply nested arithmetic
    let p8: int := (((a + 2) * (b + 1)) - ((d - c) * e)) / 3
    pr(p8)            // 43

    ret 0
}
