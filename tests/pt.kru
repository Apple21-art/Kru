// pt.kru — Kru Stage 0 + Stage 1 validation
// Clean replacement for the corrupted pt.kru file

fn arithmetic_test() -> int {
    let a := 1 + 2 * 3
    let b := ((10 + 20) * 2)
    let c := 100 / 5 - 10
    let d := 50 % 7

    pr(a)
    pr(b)
    pr(c)
    pr(d)

    ret 0
}


fn variable_test() -> int {
    let immutable := 42
    var mutable := 10
    mutable = 20

    pr(immutable)
    pr(mutable)

    ret 0
}


fn function_test(value: int) -> int {
    let result := value + 10
    ret result
}


fn scope_test() -> int {
    let outer := 100

    {
        let inner := 200
        pr(inner)
    }

    pr(outer)

    ret 0
}


fn reference_read_test() -> int {
    var value := 42
    let reference := ref value
    let loaded := reference@

    pr(value)
    pr(loaded)

    ret 0
}


fn reference_write_test() -> int {
    var value := 10
    let reference := ref value
    reference@ = 50

    pr(value)

    ret 0
}


fn expression_stress() -> int {
    let x := 10
    let y := 20
    let z := ((x + y) * (x - 5)) / 5

    pr(z)

    ret 0
}


fn control_flow_test() -> int {
    var i := 0
    var sum := 0

    while i < 5 {
        sum += i
        i += 1
    }

    pr(sum)

    if sum == 10 {
        pr(1)
    } else {
        pr(0)
    }

    ret 0
}


pub fn main() -> int {
    pr(111)
    arithmetic_test()

    pr(222)
    variable_test()

    pr(333)
    let result := function_test(32)
    pr(result)

    pr(444)
    scope_test()

    pr(555)
    reference_read_test()

    pr(666)
    reference_write_test()

    pr(777)
    expression_stress()

    pr(888)
    control_flow_test()

    ret 0
}
