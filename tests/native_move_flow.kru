struct Owner {value:i32}
impl Owner {fn drop(mut ref self) {pr(self.value)}}
fn consume(value:Owner) {pr(value.value)}
fn early(flag:bool) {
 let owner:=Owner {value:7}
 if flag {consume(owner);ret}
 consume(owner)
}
pub fn main()->i32 {
 early(true)
 early(false)
 var owner:=Owner {value:10}
 var i:=0
 while i<2 {consume(owner);owner=Owner {value:20+i};i+=1}
 ret 0
}
