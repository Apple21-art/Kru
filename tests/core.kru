// core.kru

pub fn math_test() -> int {

    let a: int := 1 + 2 * 3 - 4 / 2
    let b: int := ((10 + 20) * (30 - 10)) / 5
    let c: int := a + b * b - a / 2

    pr(a)
    pr(b)
    pr(c)

    ret c
}



pub fn variable_test() -> int {

    let first: int := 42
    let second: int := first + 8
    let third: int := second * 2

    pr(first)
    pr(second)
    pr(third)

    ret third
}



pub fn chain_test() -> int {

    let x: int := 1

    let a: int := x + 1
    let b: int := a * 2
    let c: int := b + 3
    let d: int := c * 4
    let e: int := d + 5


    pr(e)

    ret e
}



pub fn main() -> int {

    let a: int := math_test()
    let b: int := variable_test()
    let c: int := chain_test()

    pr(a)
    pr(b)
    pr(c)

    ret 0
}
