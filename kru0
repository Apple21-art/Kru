#!/usr/bin/env bash
#
# kru0 — Kru bootstrap compiler driver
#
# Responsible for:
#   1. Building the Kru compiler itself
#   2. Transpiling Kru source -> C
#   3. Compiling generated C -> native executable
#   4. Running programs
#   5. Running tests
#
# Design goals:
#   - Fast incremental builds
#   - Minimal subprocess usage
#   - Deterministic outputs
#   - Easy replacement by future self-hosted kru build
#

set -Eeuo pipefail


#######################################
# Configuration
#######################################

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

SRC_DIR="$ROOT/src"
INC_DIR="$ROOT/include"

BUILD_DIR="$ROOT/.kru"
OBJ_DIR="$BUILD_DIR/obj"
CACHE_DIR="$BUILD_DIR/cache"

COMPILER_BIN="$ROOT/kru0_bin"

CFLAGS=(
    -O3
    -pipe
)

LINK_FLAGS=()

COMPILER_SOURCES=(
    "$SRC_DIR/main.c"
    "$SRC_DIR/parse.c"
    "$SRC_DIR/sema.c"
    "$SRC_DIR/codegen.c"
    "$SRC_DIR/lexer.c"
    "$SRC_DIR/ast.c"
    "$SRC_DIR/token.c"
)


#######################################
# Logging
#######################################

log()
{
    printf "%s\n" "$1"
}


fail()
{
    printf "[error] %s\n" "$1" >&2
    exit 1
}



#######################################
# Directory setup
#######################################

init_dirs()
{
    mkdir -p \
        "$OBJ_DIR" \
        "$CACHE_DIR"
}



#######################################
# Compiler cache
#######################################

compiler_hash()
{
    sha256sum \
        "${COMPILER_SOURCES[@]}" \
        "$INC_DIR"/*.h 2>/dev/null |
    sha256sum |
    cut -d' ' -f1
}



compiler_needs_build()
{
    local hash
    hash="$(compiler_hash)"

    local old=""

    if [[ -f "$CACHE_DIR/compiler.hash" ]]; then
        old="$(cat "$CACHE_DIR/compiler.hash")"
    fi


    if [[ "$hash" != "$old" ]]; then
        return 0
    fi


    [[ ! -f "$COMPILER_BIN" ]] && return 0


    return 1
}



#######################################
# Build Kru compiler
#######################################

build_compiler()
{
    if ! compiler_needs_build; then
        return
    fi


    log "[build] rebuilding kru0 compiler"


    rm -f "$OBJ_DIR"/*.o


    local objects=()


    for src in "${COMPILER_SOURCES[@]}"
    do
        local name

        name="${src##*/}"
        name="${name%.c}"

        local obj="$OBJ_DIR/$name.o"


        gcc \
            "${CFLAGS[@]}" \
            -I"$INC_DIR" \
            -c "$src" \
            -o "$obj" &


        objects+=("$obj")
    done


    wait


    gcc \
        "${objects[@]}" \
        "${LINK_FLAGS[@]}" \
        -o "$COMPILER_BIN" ||
        fail "compiler link failed"



    compiler_hash > "$CACHE_DIR/compiler.hash"


    log "[build] kru0 ready"
}



#######################################
# Transpile
#######################################

transpile()
{
    local source="$1"
    local output="$2"


    log "[compiler] $source -> $output"


    "$COMPILER_BIN" \
        "$source" \
        "$output"
}



#######################################
# Compile generated C
#######################################

compile_c()
{
    local c="$1"
    local bin="$2"


    log "[build] gcc $c"


    gcc \
        -O3 \
        -pipe \
        "$c" \
        -o "$bin"
}



#######################################
# Execute program
#######################################

run_binary()
{
    local bin="$1"


    log "[program] running"


    "$bin"

    local code=$?


    log "[program] exit $code"


    return "$code"
}



#######################################
# Full compile pipeline
#######################################

compile_and_run()
{
    local source="$1"
    local cfile="${2:-out.c}"
    local mode="${3:-run}"


    local bin="$BUILD_DIR/program"


    if ! transpile \
        "$source" \
        "$cfile"
    then
        log "[error] transpile failed"
        return 1
    fi



    if [[ "$mode" == "build" ]]; then
        return
    fi



    if ! compile_c \
        "$cfile" \
        "$bin"
    then
        log "[error] generated C failed"
        return 1
    fi



    run_binary "$bin"
}



#######################################
# Tests
#######################################

run_tests()
{
    local passed=0
    local total=0


    log ""
    log "=== Kru tests ==="



    shopt -s nullglob


    for file in tests/*.kru tests/*.krux
    do

        total=$((total+1))


        local name
        name="${file##*/}"


        log ""
        log "[test] $name"



        local out="$BUILD_DIR/test.c"


        if compile_and_run "$file" "$out" run
        then
            log "PASS"
            passed=$((passed+1))
        else
            log "FAIL"
        fi

    done



    log ""
    log "=== Result $passed/$total ==="
}



#######################################
# Usage
#######################################

usage()
{
cat <<EOF

Usage:

 ./kru0 file.kru
        compile and run

 ./kru0 build file.kru
        compile only

 ./kru0 test
        run tests

EOF
}



#######################################
# Entry
#######################################

main()
{
    init_dirs

    build_compiler


    case "${1:-}" in

        test)
            run_tests
            ;;

        build)
            [[ -z "${2:-}" ]] &&
                fail "missing source file"

            compile_and_run \
                "$2" \
                "${3:-out.c}" \
                build
            ;;

        "")
            usage
            ;;

        *)
            compile_and_run \
                "$1" \
                "${2:-out.c}" \
                run
            ;;

    esac
}


main "$@"
