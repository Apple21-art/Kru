#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$ROOT/build/kru0"

make -C "$ROOT" >/dev/null

case "${1:-}" in
    test)
        exec make -C "$ROOT" test
        ;;
    build)
        [[ -n "${2:-}" ]] || { echo "[error] missing source file" >&2; exit 1; }
        exec "$BIN" --emit-c "$2" "${3:-out.c}"
        ;;
    "")
        echo "usage: ./kru0 [test|build] <file.kru> [out]" >&2
        exit 1
        ;;
    *)
        exec "$BIN" "$@"
        ;;
esac
