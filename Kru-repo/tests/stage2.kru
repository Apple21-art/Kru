/*
    Stage 2 conformance test.
    Tests: const, type aliases, structs, field access,
    struct literals, enums, primitive type mapping.
*/

const MAX_USERS: i32 := 100
const PI: f64 := 314
const GREETING: str := "hello"

fn generate_number() -> i32 {
    ret 999
}

type UserID := u64
type Score := i32

struct User {
    id: UserID
    age: u32
    score: Score
}

struct Point {
    x: i32
    y: i32
}

enum ResultCode {
    Ok
    Failed
    Pending
}

enum Color {
    Red
    Green
    Blue
}

fn add(a: i32, b: i32) -> i32 {
    ret a + b
}

fn make_point(x: i32, y: i32) -> Point {
    ret Point {
        x := x,
        y := y
    }
}

pub fn main() -> i32 {
    pr(MAX_USERS)
    pr(PI)

    let id: UserID := MAX_USERS
    pr(id)

    let user := User {
        id := id,
        age := 20,
        score := 85
    }

    pr(user.id)
    pr(user.age)
    pr(user.score)

    pr(add(1, 2))

    let p := make_point(3, 4)
    pr(p.x)
    pr(p.y)

    let p2 := Point {
        x := 10,
        y := 20
    }

    pr(p2.x)
    pr(p2.y)

    let ok := Ok
    pr(ok)

    let failed := Failed
    pr(failed)

    let color := Blue
    pr(color)

    let s: i16 := 42
    pr(s)

    let big: u64 := 1000
    pr(big)

    let f: f32 := 5
    pr(f)

    /*
        Regression: struct literal ambiguity.
        'flag' is lowercase, so { starts the if-block, not a struct literal.
    */

    let flag := 1
    if flag
    {
        pr(42)
    }

    /*
        Regression: forward function call.
        'helper' is declared after main but forward prototypes make this work.
    */

    pr(helper(7))

    ret 0
}

fn helper(x: i32) -> i32 {
    ret x * 2
}
