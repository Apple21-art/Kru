// ============================================================================
// MASTER TEST
// ============================================================================


pub fn main()
-> i32
{


    primitive_test()

    alias_test()

    mutation_test()

    expression_test()

    function_test()

    block_test()

    reference_test()

    mutable_reference_test()

    arena_test()

    struct_test()

    enum_test()

    match_test()

    generic_test()

    loop_test()

    secure_test()



    pr(999)


    ret 0

}
