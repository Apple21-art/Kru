// ============================================================
//
//  Stage 3 Test Suite
//
//  Tests: block expressions, arena blocks, enum variant access,
//         match expressions, generic function skip, trait/impl skip
//
// ============================================================


// --- Enum declarations ---

enum Color
{
    Red,
    Green,
    Blue
}

enum ResultCode
{
    Ok,
    Failed
}


// --- Block expression as value ---

fn block_test()
-> i32
{
    let value :=
    {
        let a := 10
        let b := 20
        a + b
    }

    ret value
}


// --- Multiple block expressions ---

fn block_chained()
-> i32
{
    let x :=
    {
        let a := 5
        a * 2
    }

    let y :=
    {
        let b := 10
        b + 3
    }

    ret x + y
}


// --- Arena block ---

fn arena_test()
-> i32
{
    var result := 42

    arena temp
    {
        let local := 100
        result = result + local
    }

    ret result
}


// --- Enum variant access ---

fn enum_access_test()
-> i32
{
    let c := Color.Green

    ret c
}


// --- Match with literal patterns ---

fn match_literal_test()
-> i32
{
    let x := 3

    match x
    {
        1 => { ret 10 }
        2 => { ret 20 }
        3 => { ret 30 }
        n => { ret 999 }
    }

    ret 0
}


// --- Match with enum variant patterns ---

fn match_enum_test()
-> i32
{
    let state := ResultCode.Ok

    match state
    {
        ResultCode.Ok => { ret 1 }
        ResultCode.Failed => { ret 0 }
    }

    ret -1
}


// --- Match catch-all ---

fn match_catchall_test()
-> i32
{
    let x := 42

    match x
    {
        1 => { ret 10 }
        n => { ret n }
    }

    ret 0
}


// --- Generic function (skipped) ---

fn identity<T>(
    value: T
)
-> T
{
    ret value
}


// --- Trait and impl (skipped) ---

trait Printable
{
    fn format()
    -> str
}

impl Printable for Color
{
    fn format()
    -> str
    {
        ret "color"
    }
}


// --- Main ---

pub fn main()
-> i32
{
    pr(block_test())        // 30
    pr(block_chained())    // 23
    pr(arena_test())       // 142
    pr(enum_access_test()) // 1 (Green = 1)
    pr(match_literal_test()) // 30
    pr(match_enum_test())  // 1
    pr(match_catchall_test()) // 42

    ret 0
}
