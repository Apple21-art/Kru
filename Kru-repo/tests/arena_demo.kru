// arena_demo.kru — Tests: arena allocation, struct, impl, methods,
// ref/mut ref parameters, @ operator, deterministic destruction

struct Vertex {
    x: f32
    y: f32
    z: f32
}

impl Vertex {
    fn new(x: f32, y: f32, z: f32) -> Vertex {
        ret Vertex { x: x, y: y, z: z }
    }

    fn magnitude(ref self) -> f32 {
        ret (self.x * self.x + self.y * self.y + self.z * self.z)
    }

    fn scale(mut ref self, factor: f32) {
        self.x *= factor
        self.y *= factor
        self.z *= factor
    }
}

// Test: pass by reference, read through @
fn dot_product(a: ref Vertex, b: ref Vertex) -> f32 {
    ret a.x * b.x + a.y * b.y + a.z * b.z
}

pub fn main() -> i32 {
    arena scratch {
        let v1 := scratch.alloc(Vertex)
        let v2 := scratch.alloc(Vertex)

        // Write through mutable reference
        v1@ = Vertex.new(1.0, 2.0, 3.0)
        v2@ = Vertex.new(4.0, 5.0, 6.0)

        // Read through @
        let mag := v1@
        pr(fmt("v1 magnitude: {0}", mag.magnitude()))

        let dp := dot_product(v1, v2)
        pr(fmt("dot product: {0}", dp))

        // Scale v1 through mutable reference
        v1@.scale(2.0)
        pr(fmt("v1 after scale: {0}", v1@.magnitude()))
    } // entire arena released here

    ret 0
}
