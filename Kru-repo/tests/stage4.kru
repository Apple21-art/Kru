// ============================================================
//
//  Stage 4 Test Suite
//
//  Tests: arrays, for loops, string operations,
//         struct semantics, tagged union enums
//
// ============================================================


// ============================================================
//  1. ARRAYS
// ============================================================


// --- Array literal, indexing, length ---

fn array_basic()
-> i32
{
    let nums: [i32; 4] := [10, 20, 30, 40]

    ret nums[0] + nums[3]
}


fn array_len()
-> i32
{
    let nums: [i32; 5] := [1, 2, 3, 4, 5]

    ret nums.len
}


// --- Array element assignment ---

fn array_write()
-> i32
{
    var nums: [i32; 3] := [1, 2, 3]

    nums[1] = 99

    ret nums[1]
}


// --- Declared length larger than the literal (zero filled) ---

fn array_zero_fill()
-> i32
{
    let buf: [i32; 8] := [7]

    ret buf.len + buf[0] + buf[7]
}


// --- Inferred array type ---

fn array_inferred()
-> i32
{
    let nums := [4, 5, 6]

    ret nums[0] * nums[1] * nums[2]
}


// --- Arrays as parameters and return values ---

fn array_sum(
    values: [i32; 4]
)
-> i32
{
    var total := 0
    var i := 0

    while i < values.len
    {
        total = total + values[i]
        i = i + 1
    }

    ret total
}


fn array_param_test()
-> i32
{
    let nums: [i32; 4] := [1, 2, 3, 4]

    ret array_sum(nums)
}


fn array_mutate(
    values: [i32; 3]
)
-> i32
{
    values[0] = 100

    ret values[0]
}


// --- Nested arrays ---

fn array_nested()
-> i32
{
    let grid: [[i32; 2]; 2] := [[1, 2], [3, 4]]

    ret grid[0][1] + grid[1][0]
}


// ============================================================
//  2. FOR LOOPS
// ============================================================


fn for_range()
-> i32
{
    var total := 0

    for i in 0..5
    {
        total = total + i
    }

    ret total
}


fn for_array()
-> i32
{
    let nums: [i32; 4] := [2, 4, 6, 8]

    var total := 0

    for n in nums
    {
        total = total + n
    }

    ret total
}


fn for_array_ref()
-> i32
{
    let nums: [i32; 3] := [5, 10, 15]

    var total := 0

    for n in ref nums
    {
        total = total + n@
    }

    ret total
}


fn for_nested()
-> i32
{
    var total := 0

    for i in 0..3
    {
        for j in 0..3
        {
            total = total + 1
        }
    }

    ret total
}


fn for_break_continue()
-> i32
{
    var total := 0

    for i in 0..10
    {
        if i == 3
        {
            continue
        }

        if i == 6
        {
            break
        }

        total = total + i
    }

    ret total
}


// ============================================================
//  3. STRING OPERATIONS
// ============================================================


fn string_len()
-> i32
{
    let greeting := "hello"

    ret str_len(greeting)
}


fn string_len_field()
-> i32
{
    let greeting := "worldly"

    ret greeting.len
}


fn string_eq()
-> i32
{
    let a := "kru"
    let b := "kru"
    let c := "other"

    if str_eq(a, b) && !str_eq(a, c)
    {
        ret 1
    }

    ret 0
}


fn string_concat()
-> str
{
    ret str_concat("kru ", "lang")
}


fn string_index()
-> i32
{
    let word := "ABC"

    ret word[0] + word[2]
}


// ============================================================
//  4. STRUCT SEMANTICS
// ============================================================


struct User
{
    id: i32,
    score: i32
}


struct Point
{
    x: i32,
    y: i32
}


fn struct_field_assign()
-> i32
{
    var user := User { id := 1, score := 10 }

    user.score = 50

    ret user.score
}


fn struct_return()
-> Point
{
    ret Point { x := 3, y := 4 }
}


fn struct_take(
    p: Point
)
-> i32
{
    ret p.x * p.y
}


fn struct_pass_test()
-> i32
{
    let p := struct_return()

    ret struct_take(p)
}


fn struct_array()
-> i32
{
    let users: [User; 3] :=
        [
            User { id := 1, score := 100 },
            User { id := 2, score := 200 },
            User { id := 3, score := 300 }
        ]

    var total := 0

    for u in users
    {
        total = total + u.score
    }

    ret total + users.len
}


fn struct_array_write()
-> i32
{
    var points: [Point; 2] :=
        [
            Point { x := 1, y := 2 },
            Point { x := 3, y := 4 }
        ]

    points[1].x = 30

    ret points[1].x + points[1].y
}


// --- Struct with a string field ---

struct Named
{
    label: str,
    weight: i32
}


fn struct_string_field()
-> i32
{
    var n := Named { label := "alpha", weight := 5 }

    n.label = "omega"

    ret str_len(n.label) + n.weight
}


// ============================================================
//  5. TAGGED UNION ENUMS
// ============================================================


enum Shape
{
    Empty

    Square(i32)

    Label(str)
}


fn shape_tag(
    s: Shape
)
-> i32
{
    match s
    {
        Shape.Empty  => { ret 0 }
        Shape.Square => { ret 1 }
        Shape.Label  => { ret 2 }
    }

    ret 9
}


fn shape_tag_test()
-> i32
{
    ret shape_tag(Shape.Empty) * 100
        + shape_tag(Square(4)) * 10
        + shape_tag(Label("x"))
}


fn shape_payload()
-> i32
{
    let s := Square(21)

    match s
    {
        Square(n) => { ret n * 2 }
        Shape.Empty => { ret 0 }
    }

    ret 0
}


fn shape_payload_str()
-> i32
{
    let s := Label("tagged")

    match s
    {
        Label(text) => { ret str_len(text) }
        Shape.Empty => { ret 0 }
    }

    ret 0
}


// ============================================================
//  MAIN
// ============================================================


pub fn main()
-> i32
{
    // Arrays
    pr(array_basic())        // 50
    pr(array_len())          // 5
    pr(array_write())        // 99
    pr(array_zero_fill())    // 15
    pr(array_inferred())     // 120
    pr(array_param_test())   // 10
    pr(array_mutate([1, 2, 3])) // 100
    pr(array_nested())       // 5

    // For loops
    pr(for_range())          // 10
    pr(for_array())          // 20
    pr(for_array_ref())      // 30
    pr(for_nested())         // 9
    pr(for_break_continue()) // 12

    // Strings
    pr(string_len())         // 5
    pr(string_len_field())   // 7
    pr(string_eq())          // 1
    pr(string_concat())      // kru lang
    pr(string_index())       // 132

    // Structs
    pr(struct_field_assign()) // 50
    pr(struct_return().x)     // 3
    pr(struct_pass_test())    // 12
    pr(struct_array())        // 603
    pr(struct_array_write())  // 34
    pr(struct_string_field()) // 10

    // Tagged unions
    pr(shape_tag_test())      // 12
    pr(shape_payload())       // 42
    pr(shape_payload_str())   // 6

    ret 0
}
