struct Packet { a: u8, b: i16, c: u64, d: u32 }
fn mix(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64) -> u64 {
    ret a + b + c + d + e + f + g + h
}
fn twice(v: i64) -> i64 { ret v * 2i64 }
pub fn main() -> i32 {
    var a: i8 := -128
    var b: u8 := 255
    var c: i16 := -32768
    var d: u16 := 65535
    let s: i64 := -9223372036854775808
    let u: u64 := 18446744073709551615u64
    pr(a)
    pr(b)
    pr(c)
    pr(d)
    pr(s)
    pr(u)
    pr(u / 3u64)
    pr(u % 3u64)
    pr(u > 9223372036854775808u64)
    pr(u >> 63u64)
    pr(s >> 63i64)
    pr(4294967295u32 >> 31u32)
    pr(twice(-4000000000i64))
    pr(mix(1u64, 2u64, 3u64, 4u64, 5u64, 6u64, 7u64, 18446744073709551587u64))
    var p := Packet { a: 255u8, b: -32768i16, c: u, d: 4294967295u32 }
    p.a = 1u8
    p.b /= 2i16
    p.c >>= 63u64
    p.d >>= 31u32
    pr(p.a)
    pr(p.b)
    pr(p.c)
    pr(p.d)
    var values: [u16; 3] := [1u16, 65535u16, 7u16]
    values[1] /= 3u16
    pr(values[0])
    pr(values[1])
    pr(values[2])
    ret 0
}
