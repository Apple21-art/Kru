use kru_result
use kru_option
fn divide(a:i32,b:i32)->kru_result::Result<i32,str> {
 if b==0 {ret kru_result::Err("zero")}
 ret kru_result::Ok(a/b)
}
fn chain(b:i32)->kru_result::Result<u64,str> {
 let v:=divide(20,b)?
 pr(100)
 ret kru_result::Ok(cast<u64>(v))
}
fn maybe(v:bool)->kru_option::Option<i32> {
 if v {ret kru_option::Some(7)}
 ret kru_option::None
}
fn opt(v:bool)->kru_option::Option<i32> {
 let x:=maybe(v)?
 pr(200)
 ret kru_option::Some(x+1)
}
pub fn main()->i32 {
 match chain(4) {kru_result::Ok(v)=>pr(v),kru_result::Err(e)=>pr(e)}
 match chain(0) {kru_result::Ok(v)=>pr(v),kru_result::Err(e)=>pr(e)}
 match opt(true) {kru_option::Some(v)=>pr(v),kru_option::None=>pr(-1)}
 match opt(false) {kru_option::Some(v)=>pr(v),kru_option::None=>pr(-1)}
 ret 0
}
