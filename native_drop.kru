struct Value { number:i32 }
impl Value {fn drop(mut ref self) {pr(self.number)}}
fn early()->i32 {
 let a:=Value{number:=10}
 { let b:=Value{number:=20} }
 ret 42
}
pub fn main()->i32 {
 pr(early())
 for i in 0..3 {
   let x:=Value{number:=i}
   if i==0 {continue}
   if i==1 {break}
 }
 Value{number:=99}
 ret 0
}
