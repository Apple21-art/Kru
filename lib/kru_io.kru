use kru_result
use kru_string
pub struct IoError { code: i64 }
pub struct FileHandle { fd: i64 }
pub fn file_open(path:str)->kru_result::Result<FileHandle,IoError> {
 let fd:=__kru_sys_open(path,0i64)
 if fd<0i64 {ret kru_result::Err(IoError{code:=fd})}
 ret kru_result::Ok(FileHandle{fd:=fd})
}
pub fn file_open_write(path:str)->kru_result::Result<FileHandle,IoError> {
 let fd:=__kru_sys_open(path,1i64)
 if fd<0i64 {ret kru_result::Err(IoError{code:=fd})}
 ret kru_result::Ok(FileHandle{fd:=fd})
}
pub fn file_write(handle:mut ref FileHandle,text:str)->kru_result::Result<i32,IoError> {
 let count:=__kru_sys_write(handle@.fd,text)
 if count<0i64 {ret kru_result::Err(IoError{code:=count})}
 ret kru_result::Ok(0)
}
pub fn file_close(handle:mut ref FileHandle)->kru_result::Result<i32,IoError> {
 let result:=__kru_sys_close(handle@.fd)
 handle@.fd = -1i64
 if result<0i64 {ret kru_result::Err(IoError{code:=result})}
 ret kru_result::Ok(0)
}
pub fn file_read(handle:mut ref FileHandle)->kru_result::Result<kru_string::String,IoError> {
 var status:=0i64
 let text:=__kru_owned_read(handle@.fd,mut ref status)
 if status<0i64 {ret kru_result::Err(IoError{code:=status})}
 ret kru_result::Ok(text)
}
pub fn str_len(text:ref str)->i32 {ret __kru_str_len(text@)}
pub fn str_eq(a:ref str,b:ref str)->bool {ret __kru_str_eq(a@,b@)}
impl FileHandle {
 fn drop(mut ref self) {
  if self.fd>=0i64 {__kru_sys_close(self.fd);self.fd=-1i64}
 }
}

// Descriptive alias; both entry points transfer ownership of the read buffer.
pub fn read_to_string(handle:mut ref FileHandle)->kru_result::Result<kru_string::String,IoError> {
 ret file_read(handle)
}
